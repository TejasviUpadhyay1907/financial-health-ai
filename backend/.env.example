# Copy to .env and fill in values. Never commit .env.

# PostgreSQL (Supabase or local)
DATABASE_URL=postgresql://user:password@host:5432/database

# LLM Provider (mock|openai)
LLM_PROVIDER=openai

# OpenAI - for narrative insights only (GPT-5 when available)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Optional: comma-separated origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.onrender.com

ENV=development
